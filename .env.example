# Banco
CAMU_DB_DSN=postgresql://camu:camu@localhost:5433/camucrm

# §12 — salt do hash de telefone. OBRIGATÓRIO em produção e ESTÁVEL:
# trocá-lo invalida todo lookup existente. Sem salt, o hash de um celular
# brasileiro é quebrável por força bruta em segundos.
CAMU_TELEFONE_SALT=troque-isto-por-um-valor-aleatorio-e-nunca-mais-mude

# Quem está operando. Vai para `correcoes.por` e para `aprovado_por` no envio.
# Sem padrão de propósito: §1 diz que quem envia é humano, sempre.
CAMU_OPERADOR=

# LLM. `fake` roda tudo sem rede (testes e eval offline).
CAMU_LLM_PROVIDER=gemini
GEMINI_API_KEY=
CAMU_GEMINI_MODEL=gemini-3.6-flash

# Transporte (§11). O padrão `console` é dry-run e não envia nada — deixe
# assim até haver motivo explícito para o contrário (§10). Estas três
# variáveis também são lidas pelo PAINEL, quando o operador usa o botão
# "Enviar pela Evolution API" na aba de prospecção (change
# `envio-prospeccao-pela-evolution-api`, `camucrm/painel/envio.py` — o único
# módulo do painel que toca essa credencial; ver a docstring de lá).
CAMU_TRANSPORTE=console
EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
# Instância padrão de envio. O popup "Enviar pela Evolution API" (change
# `escolher-instancia-no-envio-prospeccao`) lista ao vivo todas as instâncias
# cadastradas (`GET /instance/fetchInstances`) e deixa o operador escolher por
# qual número enviar — este valor é só o padrão quando nenhuma é escolhida.
EVOLUTION_INSTANCE=

# Referência de tom para os rascunhos (§10).
CAMU_PLAYBOOK=docs/playbook-tom.md

# Painel web de leitura (§13, antecipado — ver openspec/changes/painel-leitura)
CAMU_PAINEL_PORT=8093
CAMU_PAINEL_TOKEN=
CAMU_PAINEL_HOST=127.0.0.1
