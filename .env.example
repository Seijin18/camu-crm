# Banco
CAMU_DB_DSN=postgresql://camu:camu@localhost:5433/camucrm

# §12 — salt do hash de telefone. OBRIGATÓRIO em produção e ESTÁVEL:
# trocá-lo invalida todo lookup existente. Sem salt, o hash de um celular
# brasileiro é quebrável por força bruta em segundos.
CAMU_TELEFONE_SALT=troque-isto-por-um-valor-aleatorio-e-nunca-mais-mude

# Quem está operando. Vai para `correcoes.por` e para `aprovado_por` no envio.
# Sem padrão de propósito: §1 diz que quem envia é humano, sempre.
CAMU_OPERADOR=

# LLM. `fake` roda tudo sem rede (testes e eval offline).
CAMU_LLM_PROVIDER=gemini
GEMINI_API_KEY=
CAMU_GEMINI_MODEL=gemini-3.6-flash

# Transporte (§11). O padrão `console` é dry-run e não envia nada — deixe
# assim até haver motivo explícito para o contrário (§10).
CAMU_TRANSPORTE=console
EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Referência de tom para os rascunhos (§10).
CAMU_PLAYBOOK=docs/playbook-tom.md
